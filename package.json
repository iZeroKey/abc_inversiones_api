{
  "name": "abc_inversiones_api",
  "version": "1.0.0",
  "description": "ABC Inversiones API",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "app:setup": "pnpm db:push && pnpm db:seed && pnpm public-codes:backfill && pnpm db:timezone && pnpm setup:storage && pnpm setup:storage:dry-run",
    "app:reset": "tsx src/scripts/reset-app.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:api": "tsx src/scripts/seed-api.ts",
    "db:seed:demo-api": "tsx src/scripts/seed-demo-api.ts",
    "public-codes:backfill": "tsx src/scripts/backfill-public-codes.ts",
    "db:timezone": "tsx src/scripts/db-timezone.ts",
    "setup:storage": "tsx src/scripts/setup-storage.ts",
    "setup:storage:dry-run": "tsx src/scripts/setup-storage.ts --dry-run",
    "check:overdue": "tsx src/scripts/check-overdue.ts",
    "send:reminders": "tsx src/scripts/send-reminders.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@google-cloud/vision": "^5.3.5",
    "@supabase/supabase-js": "^2.57.4",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "luxon": "^3.7.2",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "jiti": "^2.6.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.9",
    "vitest": "^4.1.4"
  }
}
