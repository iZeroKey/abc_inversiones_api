# App
NODE_ENV=development
PORT=3000
APP_NAME=abc-inversiones-api
APP_TIMEZONE=America/Lima
STORAGE_SIGNED_URL_TTL_SECONDS=900
OCR_ENABLED=true
OCR_PROVIDER=google-vision

# Production
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://user:pass@host:port/db_name

# Testing
SUPABASE_URL_TEST=https://your-test-project-ref.supabase.co
SUPABASE_ANON_KEY_TEST=your-anon-key-test
SUPABASE_SERVICE_ROLE_KEY_TEST=your-service-role-key-test
DATABASE_URL_TEST=postgresql://user:pass@host:port/db_name_test
